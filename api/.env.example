# Base Postgres (Neon). Récupérer les valeurs avec : vercel env pull .env
DATABASE_URL="postgresql://..."            # connexion poolée
DATABASE_URL_UNPOOLED="postgresql://..."   # connexion directe (migrations)
ADMIN_PASSWORD="change-moi"                # mot de passe du tableau de bord
ALLOWED_ORIGIN="http://localhost:5173,http://localhost:3000"
PORT=4000
